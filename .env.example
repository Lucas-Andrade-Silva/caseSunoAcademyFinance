# Copie para .env. Nenhuma chave é obrigatória: `--provedor falso` roda tudo sem rede.
# A demo e o pytest funcionam sem este arquivo.

# Gemini gera (ADR 0007). Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Nome do modelo é configuração, nunca constante em código (ADR 0007): confira o tier gratuito no painel.
GEMINI_MODELO=gemini-2.5-flash

# Groq confere a Fidelidade e é a reserva do Gemini (ADR 0007, 0036). Chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b

# O SambaNova saiu do projeto: exige cartão de crédito (ADR 0007, 0037). O Groq é a reserva do Gemini.

# Fotos dos slides: Google Imagens pela API do Serper.dev (ADR 0033). Chave grátis (2.500 consultas, sem
# cartão, segundo fontes de terceiros) em https://serper.dev. Sem a chave a busca cai no Bing, que rende pouco.
SERPER_API_KEY=

# Qualidade pelo Jev (ADR 0035): SEMPRE ligada quando há JEV_API_KEY. Só "0" a desliga (testes); ou --sem-jev.
# Depois das medidas determinísticas, o Jev dá uma nota por dimensão; abaixo do Limiar a Célula é escrita de novo.
SUNO_JEV=1
# A chave da TypeSafe (ou o segredo da ponte que você montar). TYPESAFE_API_KEY também vale.
JEV_API_KEY=
# O endereço do systemone. Vazio = https://api.typesafe.ai/v1/systemone. Aponte para a sua Netlify Function se usar uma.
JEV_URL=
# A nota mínima de cada dimensão, de 0 a 1 (vírgula ou ponto). Vazio = 0,6. Provisório, sem Calibração.
SUNO_JEV_LIMIAR=

# Fidelidade à Ata (ADR 0036): sempre ligada. Só "0" a desliga (ou --sem-fidelidade na linha de comando).
# Um LLM lê a Ata inteira e a Célula e aponta o que a Célula diz que a Ata não diz; o código confere a citação.
# Roda no Groq e, se ele não aguentar a Ata inteira (tamanho ou cota por minuto), no Gemini: usa as chaves acima.
SUNO_FIDELIDADE=1

# Teto de requisições por minuto aos LLMs (Gemini e Groq somados, no processo inteiro). Padrão 8; 0 desliga.
SUNO_RPM=8

# Quantas vezes o Ciclo regenera uma Célula reprovada pelo Laudo (de 0 a 10). O determinístico roda de novo a cada rodada.
SUNO_RODADAS=4

# User-Agent das requisições ao BCB (ADR 0006). Coloque um contato institucional.
SUNO_CONTATO=SunoContent/0.1 (case academico; contato via repositorio)

# Onde as execuções gravam. A interface lê daqui.
SUNO_EXECUCOES=data/execucoes
