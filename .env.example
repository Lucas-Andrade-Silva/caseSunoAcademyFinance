# Copie para .env. Nenhuma chave é obrigatória: `--provedor falso` roda tudo sem rede.
# A demo e o pytest funcionam sem este arquivo.

# Gemini gera (ADR 0007). Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Nome do modelo é configuração, nunca constante em código (ADR 0007): confira o tier gratuito no painel.
GEMINI_MODELO=gemini-2.5-flash

# Groq julga (ADR 0008). Chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b

# SambaNova é reserva (ADR 0007). Chave em https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_MODELO=gpt-oss-120b

# Comitê de juízes-LLM (ADR 0008): nasce desligado. "1" liga.
SUNO_COMITE=0
# Juiz de visão do Carrossel (ADR 0014): nasce desligado. "1" liga.
SUNO_JUIZ_VISAO=0

# User-Agent das requisições ao BCB (ADR 0006). Coloque um contato institucional.
SUNO_CONTATO=SunoContent/0.1 (case academico; contato via repositorio)

# Onde as execuções gravam. A interface lê daqui.
SUNO_EXECUCOES=data/execucoes
