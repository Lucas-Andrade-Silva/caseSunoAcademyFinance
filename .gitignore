# Skills do pacote Matt Pocock (.claude/skills/) não adotadas neste projeto:
# dependem de fluxo de issue-tracker/tickets multi-sessão que este case (2 pessoas, 2 semanas) não usa,
# ou duplicam skills nativas já disponíveis (research, tdd).
.claude/skills/ask-matt/
.claude/skills/implement/
.claude/skills/improve-codebase-architecture/
.claude/skills/research/
.claude/skills/resolving-merge-conflicts/
.claude/skills/setup-matt-pocock-skills/
.claude/skills/to-spec/
.claude/skills/to-tickets/
.claude/skills/triage/
.claude/skills/wayfinder/

# Configuração pessoal do Claude Code (MCP servers, permissões locais) —
# não é do projeto, é da máquina de quem está rodando.
.claude/settings.local.json

# Ambiente
.venv/
.env
__pycache__/
*.pyc
.pytest_cache/
.superpowers/
*.egg-info/
build/
dist/

# Interface (ADR 0005)
web/node_modules/
web/dist/

# Só a demo versionada entra no repositório; qualquer outra execução (scripts/demo, testes
# manuais, --provedor roteador) é scratch local, inclusive a que scripts/demo grava em
# demo-ao-vivo/. Dentro da demo versionada, o vídeo é gravado fora do repositório (ADR 0004):
# quem quiser vê-lo roda `suno.cli video` depois do clone.
data/execucoes/*
!data/execucoes/demo-copom-280
data/execucoes/demo-copom-280/pacote/**/*.mp4
data/execucoes/demo-copom-280/pacote/**/*.wav
data/execucoes/demo-copom-280/pacote/**/*.mp3
